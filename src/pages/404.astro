---
import Base from '../layouts/Base.astro';
---

<Base search={false} title="Ni najdeno">
  <div class="wrap narrow">
    <header class="article-head">
      <span class="eyebrow">404</span>
      <h1>Te strani ni.</h1>
      <p class="lede">Morda je še nismo napisali ali pa se je naslov spremenil. <a href="/">Nazaj na začetek</a></p>
    </header>
    <form class="najdi" action="/iskanje/" method="get" role="search">
      <label for="najdi-q">Poiščite po strani</label>
      <div>
        <input id="najdi-q" name="q" type="search" placeholder="npr. cena ChatGPT" />
        <button type="submit">Išči</button>
      </div>
    </form>
  </div>
</Base>

<script is:inline>
  // Prefill the search with the words from the missing address, e.g. /vodniki/chatgpt-cena/.
  (() => {
    const words = decodeURIComponent(location.pathname).split('/').filter(Boolean).pop();
    if (words) document.getElementById('najdi-q').value = words.replace(/[-_]+/g, ' ').replace(/\.html?$/, '');
  })();
</script>

<style>
  .najdi {
    margin-top: 8px;
  }
  .najdi label {
    display: block;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .najdi div {
    display: flex;
    gap: 8px;
  }
  .najdi input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    font: inherit;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
  }
  .najdi button {
    padding: 10px 18px;
    font: inherit;
    font-weight: 600;
    border: 0;
    border-radius: 10px;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
</style>
