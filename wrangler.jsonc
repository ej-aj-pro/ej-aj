{
  // Static site served by Cloudflare Workers (assets only, no Worker script).
  "name": "ej-aj",
  "compatibility_date": "2026-09-01",
  // Required by `wrangler preview`, which builds a preview URL for every branch and PR.
  "previews": {},
  // Production is served only on ej-aj.si (custom domain). The workers.dev copy of the site was a
  // full duplicate without noindex, so it is off; branch and PR preview URLs stay on.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
