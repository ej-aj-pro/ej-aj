# Cloudflare Workers static assets headers (https://developers.cloudflare.com/workers/static-assets/headers/)
# Plain-text copies for AI tools: readable by anyone, but kept out of search results so they do
# not compete with the HTML pages as duplicates (added after the Google drop of 19 October 2026,
# see docs/seo.md).
/novice/*.md
  X-Robots-Tag: noindex
/vodniki/*.md
  X-Robots-Tag: noindex
/llms.txt
  X-Robots-Tag: noindex
/llms-full.txt
  X-Robots-Tag: noindex

# Astro puts a content hash in every file name under /_astro/ (CSS, JS), so a changed file always
# gets a new URL. Browsers can keep these for a year without asking again; HTML pages keep the
# default revalidation, so a deploy is visible at once.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
